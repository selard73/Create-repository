<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
  <Item class="Folder" referent="RBX0">
    <Properties><string name="Name">PupScripts</string></Properties>
  <Item class="Script" referent="RBX1">
    <Properties>
      <string name="Name">PupBrain</string>
      <token name="RunContext">1</token>
      <bool name="Enabled">true</bool>
      <ProtectedString name="Source"><![CDATA[
-- PupBrain (server): call the dog with the prompt and he follows you; call again and he stays.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local function findDog()
	for _, p in ipairs(workspace:GetDescendants()) do
		if p:IsA("MeshPart") and p:FindFirstChildOfClass("Bone") then return p end
	end
end
local mesh = findDog()
local waited = 0
while not mesh and waited < 10 do task.wait(0.5); waited += 0.5; mesh = findDog() end
if not mesh then warn("PupBrain: no rigged dog found") return end
local model = mesh:FindFirstAncestorOfClass("Model") or mesh
for _, p in ipairs(model:GetDescendants()) do if p:IsA("BasePart") then p.Anchored = true end end

local FOLLOW_DIST, SPEED, TURN = 6.0, 9.0, 6.0
local bones = {}
for _, b in ipairs(mesh:GetDescendants()) do if b:IsA("Bone") then bones[b.Name] = b end end
-- which way is his nose? from the hips bone toward the head bone, flattened, in the model's own frame
local pivot0 = model:GetPivot()
local rot0 = pivot0.Rotation                 -- keep the imported orientation; we only ever add a turn about Y
-- feel for the ground under him so he climbs pads and steps instead of sinking through them
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.FilterDescendantsInstances = {model}
local function groundAt(x, z, fromY)
	local r = workspace:Raycast(Vector3.new(x, fromY + 12, z), Vector3.new(0, -40, 0), rayParams)
	return r and r.Position.Y
end
local g0 = groundAt(pivot0.Position.X, pivot0.Position.Z, pivot0.Position.Y) or (pivot0.Position.Y - 2.5)
local footOffset = pivot0.Position.Y - g0        -- pivot height above the ground he stands on
local groundY = pivot0.Position.Y
model:SetAttribute("TractorTarget", true)        -- lets the UFO's beam pick him up
model:SetAttribute("Lifted", false)
-- which way is his nose right now (world, flattened)? from the hips bone toward the head bone
local fwd0 = Vector3.new(0, 0, -1)
if bones.Hips and bones.Head then
	local f = bones.Head.WorldPosition - bones.Hips.WorldPosition
	f = Vector3.new(f.X, 0, f.Z)
	if f.Magnitude > 0.1 then fwd0 = f.Unit end
end
local yawDelta = 0                            -- how far he has turned from his starting heading

-- prompt floats above his head on an attachment, nudged upward on screen, so it never covers him
local att = mesh:FindFirstChild("PromptAttachment") or Instance.new("Attachment")
att.Name = "PromptAttachment"; att.Parent = mesh
local function placeAttachment()
	local top = mesh.Position + Vector3.new(0, mesh.Size.Y / 2 + 1.2, 0)
	if bones.Head then top = bones.Head.WorldPosition + Vector3.new(0, 1.6, 0) end
	att.WorldPosition = top
end
placeAttachment()
for _, old in ipairs(mesh:GetChildren()) do if old:IsA("ProximityPrompt") then old:Destroy() end end
local prompt = att:FindFirstChildOfClass("ProximityPrompt") or Instance.new("ProximityPrompt")
prompt.ActionText = "Come here, boy!"; prompt.ObjectText = "Old Hound"; prompt.HoldDuration = 0
prompt.MaxActivationDistance = 9; prompt.RequiresLineOfSight = false
prompt.UIOffset = Vector2.new(260, -170); prompt.Parent = att

local following = nil    -- Player being followed, or nil
model:SetAttribute("Following", false); model:SetAttribute("Moving", false)
prompt.Triggered:Connect(function(player)
	if following == player then
		following = nil; prompt.ActionText = "Come here, boy!"
	else
		following = player; prompt.ActionText = "Stay"
	end
	model:SetAttribute("Following", following ~= nil)
	-- hide the prompt briefly so the dog's reaction is visible
	prompt.Enabled = false
	task.delay(3, function() prompt.Enabled = true end)
end)

RunService.Heartbeat:Connect(function(dt)
	local moving = false
	local pos = model:GetPivot().Position
	if model:GetAttribute("Lifted") then
		-- the tractor beam has him; do nothing until it lets go, then re-find the ground
		if model:GetAttribute("Moving") then model:SetAttribute("Moving", false) end
		return
	end
	-- keep his feet on whatever is under him (pad, rock, ground)
	local gy = groundAt(pos.X, pos.Z, pos.Y)
	if gy then groundY = gy + footOffset end
	-- settle onto the ground (floats down after the beam drops him)
	if math.abs(pos.Y - groundY) > 0.02 then
		local dy = groundY - pos.Y
		local stepY = math.clamp(dy, -14 * dt, 14 * dt)
		pos = Vector3.new(pos.X, pos.Y + stepY, pos.Z)
		if not following then
			model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, yawDelta, 0) * rot0); placeAttachment()
		end
	end
	if following then
		local char = following.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then following = nil; model:SetAttribute("Following", false); prompt.ActionText = "Come here, boy!" return end
		local target = Vector3.new(root.Position.X, 0, root.Position.Z)
		local toT = target - Vector3.new(pos.X, 0, pos.Z)
		local dist = toT.Magnitude
		if dist > 0.5 then
			-- turn toward the player: angle between his current nose direction and the target direction
			local nose = CFrame.Angles(0, yawDelta, 0):VectorToWorldSpace(fwd0)
			local want = toT.Unit
			local d = math.atan2(nose.X * want.Z - nose.Z * want.X, nose.X * want.X + nose.Z * want.Z)
			yawDelta += math.clamp(-d, -TURN * dt, TURN * dt)
		end
		if dist > FOLLOW_DIST then
			local step = math.min(SPEED * dt, dist - FOLLOW_DIST)
			pos = pos + toT.Unit * step
			moving = true
			local gy2 = groundAt(pos.X, pos.Z, pos.Y)
			if gy2 then groundY = gy2 + footOffset end
		end
		local y = pos.Y + math.clamp(groundY - pos.Y, -14 * dt, 14 * dt)
		model:PivotTo(CFrame.new(pos.X, y, pos.Z) * CFrame.Angles(0, yawDelta, 0) * rot0)
		placeAttachment()
	end
	if model:GetAttribute("Moving") ~= moving then model:SetAttribute("Moving", moving) end
end)
print("PupBrain ready on", model:GetFullName())
]]></ProtectedString>
    </Properties>
  </Item>
  <Item class="Script" referent="RBX2">
    <Properties>
      <string name="Name">PupIdle</string>
      <token name="RunContext">2</token>
      <bool name="Enabled">true</bool>
      <ProtectedString name="Source"><![CDATA[
-- PupIdle (client): drives the bones. Idle sit animation, plus a bunny-hop while the dog is moving.
local RunService = game:GetService("RunService")
local function findDog()
	for _, p in ipairs(workspace:GetDescendants()) do
		if p:IsA("MeshPart") and p:FindFirstChildOfClass("Bone") then return p end
	end
end
local mesh = findDog()
local waited = 0
while not mesh and waited < 10 do task.wait(0.5); waited += 0.5; mesh = findDog() end
if not mesh then warn("PupIdle: no rigged mesh with bones found") return end
local model = mesh:FindFirstAncestorOfClass("Model") or mesh
local bones = {}
for _, b in ipairs(mesh:GetDescendants()) do if b:IsA("Bone") then bones[b.Name] = b end end
local function set(name, cf) local b = bones[name]; if b then b.Transform = cf end end
local rng = Random.new()
local t = 0
local lookYaw, lookTarget, lookTimer = 0, 0, 0
local howlT, nextHowl = -1, rng:NextNumber(10, 20)
local earTwitch, earTimer = 0, rng:NextNumber(2, 5)
local hop = 0     -- 0 sitting still .. 1 full hop cycle
RunService.Heartbeat:Connect(function(dt)
	t += dt
	local moving = model:GetAttribute("Moving") == true
	local following = model:GetAttribute("Following") == true
	hop += ((moving and 1 or 0) - hop) * math.min(1, dt * 6)
	-- breathing
	local breathe = math.sin(t * 1.3) * 0.5
	-- hop: quick bounce with a forward lean, feet leave the ground
	local phase = math.abs(math.sin(t * 9))
	local bounce = phase * 0.45 * hop
	local lean = math.sin(t * 9) * 6 * hop
	set("Hips", CFrame.new(0, bounce + math.sin(t * 1.3) * 0.02, 0) * CFrame.Angles(math.rad(lean), 0, 0))
	set("Chest", CFrame.Angles(math.rad(-breathe - lean * 0.5), 0, 0))
	-- look around, or watch the person while following
	lookTimer -= dt
	if lookTimer <= 0 then lookTarget = following and 0 or rng:NextNumber(-28, 28); lookTimer = rng:NextNumber(3, 6) end
	lookYaw += (lookTarget - lookYaw) * math.min(1, dt * 2)
	-- howl only while sitting
	local pitch = 0
	if not following and howlT < 0 and t > nextHowl then howlT = 0 end
	if howlT >= 0 then
		howlT += dt
		local k = math.min(howlT / 3.5, 1)
		pitch = -40 * math.sin(k * math.pi) ^ 0.6
		if howlT >= 3.5 then howlT = -1; nextHowl = t + rng:NextNumber(14, 28) end
	end
	set("Neck", CFrame.Angles(math.rad(pitch * 0.4 - lean * 0.6), math.rad(lookYaw * 0.4), 0))
	set("Head", CFrame.Angles(math.rad(pitch * 0.6 + math.sin(t * 0.8) * 2 - lean * 0.4), math.rad(lookYaw * 0.6), 0))
	-- ears: sway, twitch, and flop with the hops
	earTimer -= dt
	if earTimer <= 0 then earTwitch = 1; earTimer = rng:NextNumber(3, 8) end
	earTwitch = math.max(0, earTwitch - dt * 3)
	local sway = math.sin(t * 2.1) * 3
	local flop = -math.sin(t * 9) * 25 * hop
	set("Ear.L", CFrame.Angles(math.rad(-sway - earTwitch * 25 + flop), 0, 0))
	set("Ear.R", CFrame.Angles(math.rad(sway + (howlT >= 0 and 15 or 0) + flop), 0, 0))
	-- tail: wag, fast when moving or howling
	local wagSpeed = (moving or howlT >= 0) and 8 or 3
	local wag = math.sin(t * wagSpeed)
	set("Tail1", CFrame.Angles(0, 0, math.rad(wag * 22)))
	set("Tail2", CFrame.Angles(0, 0, math.rad(wag * 18)))
end)
print("PupIdle running on client")
]]></ProtectedString>
    </Properties>
  </Item>
  </Item>
</roblox>
