<roblox version="4"><Item class="Folder" referent="RBX0"><Properties><string name="Name">ParkPhoto</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">PatchModule</string><ProtectedString name="Source"><![CDATA[return function()
-- temporary: park Car_Crema mid-track (the ride's own formula) for a side photo; restore_photo.lua puts it back
local F=workspace.PortoNocciola['15 Funicolare']
local car=F.Cars.Car_Crema
if not car:GetAttribute('PhotoFrom') then car:SetAttribute('PhotoFrom',car:GetPivot()) end
local A,B=F:GetAttribute('Bottom'),F:GetAttribute('Top')
local d=Vector3.new(B.X-A.X,0,B.Z-A.Z).Unit
local r=Vector3.new(-d.Z,0,d.X)
car:PivotTo(CFrame.new(A:Lerp(B,0.55)+r*car:GetAttribute('Offset'))*CFrame.lookAt(Vector3.zero,d).Rotation)
local p=car:GetPivot()
local cam=workspace.CurrentCamera
cam.Focus=CFrame.new(p.Position)
cam.CFrame=CFrame.lookAt(p*Vector3.new(9.5,0.8,1.5),p*Vector3.new(0,-1.2,0))
warn('QP@PARKED',p.Position)

end
]]></ProtectedString></Properties></Item></Item></roblox>