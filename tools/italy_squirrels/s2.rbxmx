<roblox version="4"><Item class="Folder" referent="RBX0"><Properties><string name="Name">SandroReg</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">PatchModule</string><ProtectedString name="Source"><![CDATA[return function()
-- Oct 4 2026: registry entry for Sandro the Sunbather (bio J, Shannon's pick), after Capitano Remo.
local reg=workspace.SquirrelScripts.SquirrelRegistry
local rs=reg.Source
local anchor='steers by the smell of the bakery."},\n'
local a,b=rs:find(anchor,1,true)
if not a or rs:find('sunbather_squirrel',1,true) then warn('QJ@ABORT anchor/dup',a) return end
local add='\t\t{id = "sunbather_squirrel",    map = "porto", name = "Sandro the Sunbather",\n\t\t bio = "Has been watching the horizon all summer, waiting for the perfect wave. Porto Nocciola is a very calm harbour."},\n'
reg.Source=rs:sub(1,b)..add..rs:sub(b+1)
game:GetService('ChangeHistoryService'):SetWaypoint('Sandro registry')
local n=0 for _ in reg.Source:gmatch('map = "porto"') do n+=1 end
warn('QJ@OK2 porto entries',n,'sandro',reg.Source:find('Sandro the Sunbather',1,true)~=nil)

end]]></ProtectedString></Properties></Item></Item></roblox>