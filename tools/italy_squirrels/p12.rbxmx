<roblox version="4"><Item class="Folder" referent="RBX0"><Properties><string name="Name">ProbeP12</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">PatchModule</string><ProtectedString name="Source"><![CDATA[return function()
local seen={}
for _,d in ipairs(workspace.PortoNocciola:GetDescendants()) do
	local n=d.Name:lower()
	if (n:find('umbrella') or n:find('parasol') or n:find('ombrell') or n:find('towel') or n:find('telo') or n:find('lounger') or n:find('beach')) then
		local p=d.Parent
		local pn=p and p.Name:lower() or ''
		local parentHit=pn:find('umbrella') or pn:find('parasol') or pn:find('ombrell') or pn:find('towel') or pn:find('lounger')
		if not parentHit then
			if d:IsA('Model') then local c,s=d:GetBoundingBox() warn(string.format('QU@M %s c(%.1f,%.1f,%.1f) s(%.1f,%.1f,%.1f)',d:GetFullName():gsub('Workspace.PortoNocciola.',''),c.X,c.Y,c.Z,s.X,s.Y,s.Z))
			elseif d:IsA('BasePart') then warn(string.format('QU@P %s (%.1f,%.1f,%.1f) s(%.1f,%.1f,%.1f)',d:GetFullName():gsub('Workspace.PortoNocciola.',''),d.Position.X,d.Position.Y,d.Position.Z,d.Size.X,d.Size.Y,d.Size.Z))
			elseif d:IsA('Folder') then warn('QU@F '..d:GetFullName()) end
		end
	end
end
warn('QU@END')

end]]></ProtectedString></Properties></Item></Item></roblox>