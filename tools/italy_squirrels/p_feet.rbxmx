<roblox version="4"><Item class="Folder" referent="RBX0"><Properties><string name="Name">ProbeFeet</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">PatchModule</string><ProtectedString name="Source"><![CDATA[return function()
-- Oct 5 2026 read-only: what each foot of a swapped squirrel stands on (rays straight down from 1 stud above the sole).
-- Foot points in Blender units (feet_probe clusters), sx 1, same mapping as swap_model.template.lua.
local JOBS={
	-- Oct 5 sunbather: 4 foot points, then 2 surfboard-base points (last two)
	sunbather_squirrel={{-0.25,-0.35},{-0.06,-0.02},{0.52,-0.08},{0.84,-0.30},{-0.50,-0.30},{-0.40,-0.10}},
	-- Oct 6 netmender (Antigravity): left foot, right foot x2, then 2 net-on-ground points (last two)
	netmender_squirrel={{-0.69,-0.21},{0.17,0.19},{-0.09,0.32},{0.91,-1.05},{1.40,-0.80}},
	-- Oct 6 deckhand (Antigravity): left foot x2, right foot x2
	deckhand_squirrel={{-0.29,-0.65},{-0.09,-0.61},{0.47,-0.39},{0.72,-0.50}},
}
for id,pts in pairs(JOBS) do
	local col=workspace:FindFirstChild(id..'_color')
	if col and col:FindFirstChild('Squirrel') and not col.Squirrel:GetAttribute('ProbeSkip') then
		local cm=col.Squirrel
		local B={} for _,d in ipairs(col:GetDescendants()) do if d:IsA('Bone') then B[d.Name]=d end end
		local hl=cm.CFrame:PointToObjectSpace(B.Head.WorldPosition) local sz=hl.Z<0 and 1 or -1
		local k=3.4/cm.Size.Y local R=cm.CFrame-cm.Position
		local sole=cm.Position.Y-cm.Size.Y/2
		local rp=RaycastParams.new() rp.FilterType=Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances={col,workspace:FindFirstChild('SquirrelTwins')}
		local out={}
		for _,f in ipairs(pts) do
			local w=cm.Position+R:VectorToWorldSpace(Vector3.new(f[1],0,sz*f[2])*k)
			local hit=workspace:Raycast(Vector3.new(w.X,sole+1,w.Z),Vector3.new(0,-6,0),rp)
			table.insert(out,hit and string.format('%s gap %.2f',hit.Instance.Name,sole-hit.Position.Y) or 'NOTHING')
		end
		warn('QF@'..id,'sole',string.format('%.2f',sole),table.concat(out,' | '))
	end
end

end
]]></ProtectedString></Properties></Item></Item></roblox>