<roblox version="4"><Item class="Folder" referent="RBX0"><Properties><string name="Name">PBoat</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">PatchModule</string><ProtectedString name="Source"><![CDATA[return function()
-- Oct 5 2026 read-only: list the boats in Porto Nocciola (models whose name says boat / barca / a boat's own name),
-- with size, centre, the flat deck-like parts on top and any squirrel standing within 6 studs.
local PN=workspace:FindFirstChild('PortoNocciola')
if not PN then warn('QB@ABORT no PortoNocciola') return end
local squirrels={}
for _,m in ipairs(workspace:GetChildren()) do
	if m:IsA('Model') and m.Name:match('_squirrel_color$') and m:FindFirstChild('Squirrel') then
		table.insert(squirrels,{m.Name:gsub('_color$',''),m.Squirrel.Position})
	end
end
local seen={}
local n=0
for _,m in ipairs(PN:GetDescendants()) do
	if m:IsA('Model') and not seen[m] then
		local nm=m.Name:lower()
		if nm:match('boat') or nm:match('barca') or nm:match('pescher') or nm:match('gozzo') or nm:match('hull') or nm:match('trawler')
			or m.Name=='Azzurra' or m.Name=='Stella Marina' or m.Name=='Nuova Alba' then
			-- skip a boat model nested inside another listed boat
			local p=m.Parent local nested=false
			while p and p~=PN do if seen[p] then nested=true end p=p.Parent end
			if not nested then
				seen[m]=true n+=1
				local cf,sz=m:GetBoundingBox()
				local near={}
				for _,s in ipairs(squirrels) do
					local d=(Vector3.new(s[2].X,0,s[2].Z)-Vector3.new(cf.Position.X,0,cf.Position.Z)).Magnitude
					if d<math.max(sz.X,sz.Z)/2+2 then table.insert(near,s[1]) end
				end
				local decks={}
				for _,d in ipairs(m:GetDescendants()) do
					if d:IsA('BasePart') then
						local dn=d.Name:lower()
						if dn:match('deck') or dn:match('floor') or dn:match('seat') or dn:match('bench') or dn:match('thwart') then
							table.insert(decks,string.format('%s@%.1f,%.2f,%.1f sz %.1fx%.1f',d.Name,d.Position.X,d.Position.Y+d.Size.Y/2,d.Position.Z,d.Size.X,d.Size.Z))
						end
					end
				end
				warn(string.format('QB@%d %s | parent %s | centre %.1f,%.1f,%.1f | size %.1f x %.1f x %.1f | squirrels: %s',n,m.Name,m.Parent.Name,
					cf.Position.X,cf.Position.Y,cf.Position.Z,sz.X,sz.Y,sz.Z,#near>0 and table.concat(near,',') or 'none'))
				for i=1,math.min(#decks,5) do warn('QB@  deck '..decks[i]) end
			end
		end
	end
end
warn('QB@DONE',n)

end
]]></ProtectedString></Properties></Item></Item></roblox>