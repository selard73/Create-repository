<roblox version="4"><Item class="Folder" referent="RBX0"><Properties><string name="Name">SwapE</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">PatchModule</string><ProtectedString name="Source"><![CDATA[return function()
-- Oct 5 2026 read-only: every place the old harbour squirrel names appear (scripts outside ServerStorage + GUI text + part names)
local OLD={'Signor Timbro','Timbro','Beppe','Nonno Reti','Giulia','Vito','Capitano Remo','Remo','Sandro','Enzo','Tonio','Rocco','Lello','Tito'}
local function hits(src,w)
	local n,i,first=0,1,nil
	while true do
		local a,b=src:find('%f[%w]'..w:gsub('%s','%%s')..'%f[%W]',i)
		if not a then break end
		n+=1 first=first or a i=b+1
	end
	return n,first
end
for _,s in ipairs(game:GetDescendants()) do
	local ok,src
	if s:IsA('LuaSourceContainer') and not s:IsDescendantOf(game:GetService('ServerStorage')) then ok,src=pcall(function() return s.Source end)
	elseif s:IsA('TextLabel') or s:IsA('TextButton') or s:IsA('TextBox') then ok,src=true,s.Text end
	if ok and src and #src>0 then
		for _,w in ipairs(OLD) do
			local n,a=hits(src,w)
			if n>0 then
				local ls=a while ls>1 and src:sub(ls-1,ls-1)~='\n' do ls-=1 end
				local le=src:find('\n',a,true) or #src+1
				warn('QN@',s:GetFullName(),'|',w,'x'..n,'::',src:sub(ls,math.min(le-1,ls+300)))
			end
		end
	end
end
warn('QN@DONE')

end
]]></ProtectedString></Properties></Item></Item></roblox>